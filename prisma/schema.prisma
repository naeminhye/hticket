generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Event {
  id          String    @id @default(cuid())
  titleVi     String    @map("title_vi") @default("")
  titleEn     String    @map("title_en") @default("")
  description String    @default("")
  venue       String    @default("")
  startAt     String    @map("start_at") @default("")
  endAt       String    @map("end_at") @default("")
  policy      String    @default("")
  cover       String    @default("#FF8FA8")
  cover2      String    @default("#C4B5FB")
  badge       String    @default("concert")
  status      String    @default("open")
  sold        Int       @default(0)
  held        Int       @default(0)
  revenue     Float     @default(0)
  createdAt   DateTime  @map("created_at") @default(now())
  publishedAt DateTime? @map("published_at")
  zones       Zone[]
  orders      Order[]

  @@map("events")
}

model Zone {
  id          String  @id @default(cuid())
  eventId     String  @map("event_id")
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String  @default("")
  type        String  @default("seating")
  color       String  @default("#FF8FA8")
  x           Float   @default(0)
  y           Float   @default(0)
  w           Float   @default(240)
  h           Float   @default(80)
  capacity    Int     @default(200)
  price       Int     @default(0)
  rows        Int?
  cols        Int?
  queuePrefix String? @map("queue_prefix")
  sortOrder   Int     @map("sort_order") @default(0)

  @@map("zones")
}

model Order {
  id        String   @id @default(cuid())
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id])
  buyer     String   @default("")
  email     String   @default("")
  phone     String   @default("")
  areaName  String   @map("area_name") @default("")
  qty       Int      @default(1)
  total     Int      @default(0)
  status    String   @default("paid")
  items     Json     @default("[]")
  createdAt DateTime @map("created_at") @default(now())

  @@map("orders")
}
